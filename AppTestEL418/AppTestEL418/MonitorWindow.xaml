<Window x:Class="AppTestEL418.MonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AppTestEL418"
        Title="EL418 - Monitor tension / courant / puissance"
        Height="820" Width="1100"
        Background="#1A1A1D" Foreground="White"
        WindowStartupLocation="CenterOwner"
        Icon="Images/logo.ico"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2F36"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A86FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ClearButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="BorderBrush" Value="#FF4757"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4757"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CC3A46"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre de commande -->
        <Border Grid.Row="0" Background="#25262B" CornerRadius="12" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnStart" Content="▶ Démarrer" Width="120" Margin="0,0,10,0"
                            Style="{StaticResource ModernButton}" Click="BtnStart_Click"/>
                    <Button x:Name="btnStop" Content="◼ Arrêter" Width="120" Margin="0,0,10,0"
                            Style="{StaticResource ModernButton}" Click="BtnStop_Click"/>
                    <Button x:Name="btnClear" Content="🗑 Effacer" Width="110"
                            Style="{StaticResource ClearButton}" Click="BtnClear_Click"/>
                </StackPanel>

                <TextBlock x:Name="txtStatus" Grid.Row="0" Grid.Column="1"
                           VerticalAlignment="Center" Margin="20,0,0,0"
                           FontSize="14" FontWeight="SemiBold" Foreground="#888"
                           Text="■ Stream arrêté"/>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="FENÊTRE" Foreground="#888" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="btnW30" Content="30 s" Tag="30" Width="70" Margin="0,0,6,0"
                            Style="{StaticResource ModernButton}" Click="BtnWindow_Click"/>
                    <Button x:Name="btnW60" Content="1 min" Tag="60" Width="70" Margin="0,0,6,0"
                            Style="{StaticResource ModernButton}" Click="BtnWindow_Click"/>
                    <Button x:Name="btnW300" Content="5 min" Tag="300" Width="70"
                            Style="{StaticResource ModernButton}" Click="BtnWindow_Click"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0"
                           FontSize="12" Foreground="#888" TextWrapping="Wrap"
                           Text="ℹ Le mode monitor suspend le test en cours. À l'arrêt du stream ou à la fermeture de cette fenêtre, la carte repart à l'ÉTAPE 0."/>
            </Grid>
        </Border>

        <!-- Oscillogrammes -->
        <Border Grid.Row="1" Background="#0D0D0F" CornerRadius="12" BorderBrush="#3A3B40"
                BorderThickness="1" Margin="0,0,0,10">
            <local:ScopeControl x:Name="scopeV" Title="TENSION" Unit="V" MinSpan="0.5"
                                LineBrush="#3A86FF" Margin="8"/>
        </Border>

        <Border Grid.Row="2" Background="#0D0D0F" CornerRadius="12" BorderBrush="#3A3B40"
                BorderThickness="1" Margin="0,0,0,10">
            <local:ScopeControl x:Name="scopeI" Title="COURANT" Unit="mA" MinSpan="5"
                                LineBrush="#FFA502" Margin="8"/>
        </Border>

        <Border Grid.Row="3" Background="#0D0D0F" CornerRadius="12" BorderBrush="#3A3B40"
                BorderThickness="1">
            <local:ScopeControl x:Name="scopeP" Title="PUISSANCE" Unit="mW" MinSpan="50"
                                LineBrush="#26DE81" Margin="8"/>
        </Border>
    </Grid>
</Window>